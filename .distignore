# Files and folders that should not be deployed to WordPress.org.
# The deploy action rsyncs the workspace to SVN trunk with --delete,
# so anything not listed here (and not generated by the build steps in
# deploy.yml) ends up in the plugin zip, and anything listed here is
# kept out of it.
/.git
/.github
/.wordpress-org
/.cache
/.distignore
/.editorconfig
/.eslintrc
/.gitattributes
/.gitignore
/.phpcs.xml.dist
/CONTRIBUTING.md
/Gruntfile.js
/LICENSE
/README.md
/Security.md
/composer.json
/composer.lock
/grunt
/node_modules
/package.json
/phpunit.xml.dist
/svn-assets
/tests
/yarn.lock
